# ============================================================
# RUDU FARM — FIREBASE & ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Frontend Safe Firebase Client Variables (Vite & Next.js compatible)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Server-Only Firebase Admin SDK Credentials (NEVER expose to client)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================================
# FAST2SMS DLT CONFIGURATION (SERVER-SIDE ONLY - NEVER CLIENT EXPOSE)
# ============================================================
FAST2SMS_API_KEY=
FAST2SMS_BASE_URL=https://www.fast2sms.com/dev
FAST2SMS_ROUTE=dlt
FAST2SMS_SENDER_ID=
FAST2SMS_ENTITY_ID=

# Approved Fast2SMS DLT Message Template IDs
FAST2SMS_MILK_COLLECTION_TEMPLATE_ID=
FAST2SMS_PAYMENT_TEMPLATE_ID=
FAST2SMS_ADVANCE_TEMPLATE_ID=
FAST2SMS_OTP_TEMPLATE_ID=
FAST2SMS_PASSWORD_RESET_TEMPLATE_ID=
FAST2SMS_ACCOUNT_CREATED_TEMPLATE_ID=
FAST2SMS_OPERATOR_LOGIN_TEMPLATE_ID=
FAST2SMS_OPERATOR_LOGOUT_TEMPLATE_ID=
FAST2SMS_SESSION_EXPIRY_TEMPLATE_ID=
FAST2SMS_PAYMENT_REMINDER_TEMPLATE_ID=
FAST2SMS_LEDGER_STATEMENT_TEMPLATE_ID=
FAST2SMS_MONTHLY_STATEMENT_TEMPLATE_ID=
FAST2SMS_LOW_BALANCE_TEMPLATE_ID=
FAST2SMS_RATE_CHANGE_TEMPLATE_ID=
FAST2SMS_GENERAL_NOTIFICATION_TEMPLATE_ID=

# SMS Provider Mode: 'mock' (local dev & testing) or 'fast2sms' (production)
SMS_PROVIDER=mock
